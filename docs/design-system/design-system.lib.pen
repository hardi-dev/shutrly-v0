              "fontFamily": "$font/family/base",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "VR824",
              "name": "Line",
              "fill": "$color/semantic/text/secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Naming — Pencil variable = token path with “/”: color.semantic.text.primary ⇄ $color/semantic/text/primary. Canonical source: docs/design-system/tokens.json.",
              "lineHeight": 1.5,
              "fontFamily": "$font/family/base",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "iocqQ",
              "name": "Line",
              "fill": "$color/semantic/text/secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Modes — dark columns are frames with theme mode = dark; the same variable resolves to its dark value there.",
              "lineHeight": 1.5,
              "fontFamily": "$font/family/base",
              "fontSize": 13,
              "fontWeight": "normal"
