            {
              "type": "text",
              "id": "wjqZG",
              "name": "Token note",
              "fill": "#5E5B55",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "input.bg → surface.panel · input.border → neutral.300 | neutral.700 · hover → neutral.400 | neutral.500 · focus → action.primary 2px + ring blue.500 @25% · error → status.danger (border red.600 | red.400, message red.700 | red.400) · disabled → surface.subtle + text neutral.400 | neutral.500 · placeholder → text.muted · label → text.primary 13/600 · helper → text.muted 12 · radius → sm (8), height 40.   control.border (checkbox/radio unchecked) → neutral.500 · checked/selected/switch-on/stepper-primary → action.primary + on-primary · switch-off → neutral.300 | neutral.700.",
              "lineHeight": 1.35,
              "fontFamily": "IBM Plex Mono",
              "fontSize": 10,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "k90WQI",
              "name": "A11y finding",
              "fill": "#B91C1C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A11Y-RISK (new GAP-06): input border neutral.300 on white ≈ 1.5:1 and neutral.700 on #18181B ≈ 1.7:1 — below WCAG 1.4.11 (3:1) for field boundaries. Options: border neutral.500 (light 4.8:1 / dark 3.7:1), or keep soft border + always-visible label (current). Checkbox/radio borders already use neutral.500 (≥ 3:1).",
              "lineHeight": 1.35,
              "fontFamily": "IBM Plex Mono",
              "fontSize": 10,
              "fontWeight": "normal"
            }
          ]
        },
