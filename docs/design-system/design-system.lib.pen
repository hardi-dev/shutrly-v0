                  "type": "text",
                  "id": "Cay8H",
                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Page behind is inert (inert / aria-hidden) and scroll-locked.",
