{
  "version": "2.20",
  "children": [
    {
      "type": "frame",
      "id": "j1xyVG",
      "x": 21000,
      "y": -1500,
      "name": "Pick Tile",
      "context": "Client Pick Tile (F-10, local). Image tile with a select control (top right) and an optional quantity chip (bottom left). States by overrides: unselected, selected (Select fill action.primary + Check on), quantity (Qty enabled), locked (Select disabled). Missing photos use Photo Tile/Missing. Note (top left, A-32): enabled when the pick has a client note; label off = icon only. Option B also shows it on picked tiles without a note, icon message-square-plus.",
      "reusable": true,
      "width": 200,
      "layout": "vertical",
      "gap": "$3:component/photo-tile/gap",
      "children": [
        {
          "type": "frame",
          "id": "ZlGuS",
          "name": "Image",
          "clip": true,
          "width": "fill_container",
          "height": 180,
          "fill": {
            "type": "image",
            "enabled": true,
            "url": "https://images.unsplash.com/photo-1763673404916-0b9eb4b30e7f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w4NDM0ODN8MHwxfHJhbmRvbXx8fHx8fHx8fDE3OTEwNTgwMzl8&ixlib=rb-4.1.0&q=80&w=1080",
            "mode": "cover"
          },
          "cornerRadius": "$3:component/photo-tile/image-radius",
          "layout": "none",
          "children": [
            {
              "type": "frame",
              "id": "f4Yby3",
              "x": 160,
              "y": 8,
              "name": "Select",
