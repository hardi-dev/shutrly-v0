                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Decorative when the number is repeated elsewhere; otherwise never colour-only (it's a number).",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
