            0,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "c6EsJ",
              "name": "Notes",
              "width": 360,
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "CYgEM",
                  "name": "Exhibit title",
                  "fill": "$color/semantic/text/primary",
                  "content": "Usage",
                  "fontFamily": "$font/family/base",
                  "fontSize": "$font/size/title",
