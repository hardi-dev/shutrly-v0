                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Visible <label for> on every field; the placeholder is never the accessible name.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
