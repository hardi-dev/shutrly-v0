                },
                {
                  "type": "text",
                  "id": "svM3D",
                  "name": "Exhibit note",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A modal interrupts. Use it only when the task must finish (or be cancelled) before the page continues.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "H0aOF",
              "name": "Artwork",
              "width": "fill_container",
              "fill": "$color/semantic/surface/canvas",
              "cornerRadius": "$radius/md",
              "layout": "vertical",
              "gap": 16,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "dal5q",
                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Do: one modal at a time; never open a modal from a modal.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "$font/weight/regular"
                },
                {
                  "type": "text",
                  "id": "owD0i",
                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Do: SM for confirmations, MD for short forms (≤ 5 fields), LG for read-mostly detail. Longer flows get a page.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "$font/weight/regular"
                },
                {
                  "type": "text",
                  "id": "A6YYs",
                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Do: actions right-aligned, Cancel (Secondary) then the confirming action; at most one Primary or one Danger.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "$font/weight/regular"
                },
                {
                  "type": "text",
                  "id": "grBgU",
                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Do: Danger only for destructive, irreversible actions; the label repeats the verb (“Hapus proyek”), never “Ya” / “OK”.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "$font/weight/regular"
                },
                {
                  "type": "text",
                  "id": "NFvux",
                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Don't: stack toasts or menus over the scrim; don't put a Table with row actions inside a modal (use a page).",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "$font/weight/regular"
                },
                {
                  "type": "text",
                  "id": "ugwj6",
                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Mobile (client gallery, GAP-04): use the Bottom Sheet (C32) instead.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "$font/weight/regular"
                }
              ]
            }
          ]
        },
