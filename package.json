{
  "name": "shutrly",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "prettier --check . && eslint . && pnpm tokens:check",
    "tokens:css": "tsx scripts/tokens/tokens-css.ts",
    "tokens:check": "tsx scripts/tokens/tokens-css.ts --check",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:set-status": "tsx --conditions=react-server scripts/auth/set-user-status.ts",
    "auth:purge-rate-limits": "tsx --conditions=react-server scripts/auth/purge-auth-rate-limits.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "@tailwindcss/oxide"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@internationalized/date": "3.12.4",
    "@neondatabase/serverless": "1.1.0",
    "@opennextjs/cloudflare": "1.20.6",
    "@react-aria/toast": "3.0.8",
    "@react-stately/toast": "3.2.1",
    "better-auth": "1.7.6",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,jsonc}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "18.0.4",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "simple-git-hooks": "2.14.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
