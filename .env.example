# Copy the keys you need into .dev.vars (next dev, drizzle-kit)
# and .env.test (integration tests). Never commit real values. Non-production only.
DATABASE_URL=            # Neon non-prod, POOLED connection string
DATABASE_URL_UNPOOLED=   # Neon non-prod, DIRECT connection string (migrations only, .dev.vars)
APP_STAGE=               # development in .dev.vars, test in .env.test

# F-01 Auth (.dev.vars and .env.test). Non-production values only.
BETTER_AUTH_SECRET=      # >= 32 random characters
BETTER_AUTH_URL=         # http://localhost:3000 locally
GOOGLE_CLIENT_ID=        # non-production OAuth client, identity scopes only (ADR-012)
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=          # a Resend test key
RESEND_WAITLIST_API_KEY= # F-19 waitlist: a full-access Resend key (ADR-022); optional
RESEND_WAITLIST_SEGMENT_ID= # F-19 waitlist: the environment's segment UUID; optional
AUTH_EMAIL_FROM=         # "Shutrly <auth@…>", a verified Resend sender
E2E_EMAIL_CAPTURE=       # 1 in .dev.vars for local E2E: auth emails stay in memory (Task 31)

# F-09 Gallery (.dev.vars and .env.test). Non-production values only.
GOOGLE_DRIVE_API_KEY=    # GCP API key restricted to the Drive API (ADR-005)
GALLERY_PASSWORD_KEY=    # 32 random bytes, base64url without padding (43 characters, ADR-017)
E2E_FAKE_DRIVE=          # 1 in .dev.vars for local E2E: a fixture Drive provider (never in production)
GALLERY_SMOKE_FOLDER_URL= # optional, .env.test only: a public Drive folder link; runs the real-Drive smoke E2E
