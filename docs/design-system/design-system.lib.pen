                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Announce with its label: \"Proyek, 12\" — put the count inside the link/button name, or aria-label on the parent.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
