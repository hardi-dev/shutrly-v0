                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Helper and error are linked with aria-describedby; error sets aria-invalid=true and is announced (role=alert on submit).",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
