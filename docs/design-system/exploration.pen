                {
                  "type": "text",
                  "id": "E6HdnH",
                  "fill": "#1F1E1C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "No new primitives or semantics.\nsheet.scrim             → overlay.scrim\nsheet.background        → surface.panel\nsheet.radius            → radius.xl  24\nsheet.grabber           → border.input  (#D4D4D8 / #3F3F46)\nsheet.title             → text.primary   (title 18/700)\nsheet.description       → text.secondary (body-sm 13)\nsheet.item.text         → text.primary   (subtitle 16/500)\nsheet.item.icon         → text.secondary (20 px)\nsheet.item.text-destructive → status.danger.fg\nButtons: Button Primary / Secondary / Danger LG, full width\nshadow: elevation.2 (A: offset upward)\nItem height 48–52 literal (≥ 44 touch target)",
                  "lineHeight": 1.6,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 11
                }
              ]
            },
            {
              "type": "frame",
              "id": "kfruT",
              "width": "fill_container",
