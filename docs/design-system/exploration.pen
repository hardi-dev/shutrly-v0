        {
          "type": "frame",
          "id": "zCFXV",
          "name": "Proposed tokens",
          "width": "fill_container",
          "gap": 40,
          "children": [
            {
              "type": "frame",
              "id": "bZpM4",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "iYtzV",
                  "fill": "#1F1E1C",
                  "content": "Shared (A and B)",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "E6HdnH",
                  "fill": "#1F1E1C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "No new primitives or semantics.\nsheet.scrim             → overlay.scrim\nsheet.background        → surface.panel\nsheet.radius            → radius.xl  24\nsheet.grabber           → border.input  (#D4D4D8 / #3F3F46)\nsheet.title             → text.primary   (title 18/700)\nsheet.description       → text.secondary (body-sm 13)\nsheet.item.text         → text.primary   (subtitle 16/500)\nsheet.item.icon         → text.secondary (20 px)\nsheet.item.text-destructive → status.danger.fg\nButtons: Button Primary / Secondary / Danger LG, full width\nshadow: elevation.2 (A: offset upward)\nItem height 48–52 literal (≥ 44 touch target)",
                  "lineHeight": 1.6,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "kfruT",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "wPHyF",
                  "fill": "#1F1E1C",
                  "content": "Option A — Docked",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "PKkp0",
                  "fill": "#1F1E1C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "sheet.header.padding-y → space.3  12\nsheet.header.padding-x → space.5  20\nsheet.header.border    → border.default\nsheet.item.padding-x   → space.5  20\nsheet.item.gap         → space.3  12  (legacy-free; 14 drawn → 12)\nsheet.item.border      → border.subtle\nsheet.body.padding     → space.4 / space.5\nsheet.footer.background→ surface.subtle\nsheet.footer.padding   → space.4 / space.5\n≈ 18 tokens · pairs with Modal A (same header divider + subtle footer)",
                  "lineHeight": 1.6,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Q4tn62",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "Fi0g4",
                  "fill": "#1F1E1C",
                  "content": "Option B — Floating",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "DMp7x",
                  "fill": "#1F1E1C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "sheet.inset            → space.2  8  (sides + above home bar)\nsheet.border           → L none · D border.default\nsheet.padding          → space.5  20  (action list: space.2 8)\nsheet.gap              → space.4  16\nsheet.item.radius      → radius.md 12\nsheet.item.background-hover → surface.sunken\nsheet.option.radius    → radius.lg 16\nsheet.cancel           = separate card, same tokens\n≈ 17 tokens · iOS-like; differs from Modal A (no dividers)",
                  "lineHeight": 1.6,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "rectangle",
