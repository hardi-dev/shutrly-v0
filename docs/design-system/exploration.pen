                  "fontSize": 20
                },
                {
                  "type": "text",
                  "id": "PKkp0",
                  "fill": "#1F1E1C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "sheet.header.padding-y → space.3  12\nsheet.header.padding-x → space.5  20\nsheet.header.border    → border.default\nsheet.item.padding-x   → space.5  20\nsheet.item.gap         → space.3  12  (legacy-free; 14 drawn → 12)\nsheet.item.border      → border.subtle\nsheet.body.padding     → space.4 / space.5\nsheet.footer.background→ surface.subtle\nsheet.footer.padding   → space.4 / space.5\n≈ 18 tokens · pairs with Modal A (same header divider + subtle footer)",
                  "lineHeight": 1.6,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 11
