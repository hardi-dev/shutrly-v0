              "layout": "vertical",
              "gap": 16,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "GZwGe",
                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  role=dialog + aria-modal=true; aria-labelledby = Title, aria-describedby = Description (or the confirm body). Destructive confirms use role=alertdialog.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "$font/weight/regular"
                },
                {
                  "type": "text",
                  "id": "BdoUt",
                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Focus moves into the modal on open (first field, or Cancel for a destructive confirm) and is trapped; on close it returns to the trigger.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "$font/weight/regular"
                },
                {
                  "type": "text",
                  "id": "QuJCn",
                  "name": "Bullet",
                  "fill": "$color/semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Esc and the Close button (aria-label “Tutup”) cancel. Clicking the scrim cancels forms only when nothing was typed.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font/family/base",
                  "fontSize": 13,
                  "fontWeight": "$font/weight/regular"
                },
